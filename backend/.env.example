PORT=4000
TRUST_PROXY=1
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
DATABASE_URL=postgres://postgres:postgres@localhost:5432/video_platform
REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:5173,https://lemexplain.com,https://www.lemexplain.com
PUBLIC_FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
MAX_DEVICES_PER_USER=2
# Лимит mp4 при загрузке в админке (байты). По умолчанию 2 ГБ — должен совпадать с nginx client_max_body_size.
# MAX_UPLOAD_BYTES=2147483648
HLS_KEY_SECRET=replace-hls-key-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# Finik Acquiring (https://www.finik.kg)
FINIK_ENV=prod
FINIK_API_KEY=
FINIK_ACCOUNT_ID=
FINIK_PRIVATE_KEY_PATH=./finik_private.pem
# FINIK_PRIVATE_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
FINIK_WEBHOOK_URL=https://api.lemexplain.com/billing/webhook/finik
FINIK_AMOUNT=1
# FINIK_AMOUNT_STANDARD=1
# BILLING_STUB=true
